<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cz.kso.fabric</groupId>
        <artifactId>storage-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>storage-client</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-storage-api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
<!--                            <apiNameSuffix>Test</apiNameSuffix>-->
                            <inputSpec>${api.path}</inputSpec>
                            <generatorName>java</generatorName>
                            <configOptions>
                                <apiClientName>${client.name}</apiClientName>
                                <library>restclient</library>
                                <openApiNullable>false</openApiNullable>
                                <useJakartaEe>true</useJakartaEe>
                                <useSpringBoot4>true</useSpringBoot4>
                                <useJackson3>true</useJackson3>

                                <apiPackage>${client.package}</apiPackage>
                                <modelPackage>${client.package}.model</modelPackage>
                                <invokerPackage>${client.package}.invoker</invokerPackage>
                            </configOptions>

                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>

                            <globalProperties>
                                <supportingFiles>
                                    ApiClient.java,
                                    JavaTimeFormatter.java,
                                    RFC3339DateFormat.java,
                                    ExceptionProvider.java,
                                    ServerConfiguration.java,
                                    ServerVariable.java,
                                    Authentication.java,
                                    ApiKeyAuth.java,
                                    HttpBasicAuth.java,
                                    HttpBearerAuth.java,
                                    HttpBearerAuthInterceptor.java
                                </supportingFiles>
                            </globalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
